{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "compatibility_date": "2026-05-11",
  "main": "src/main.ts",
  "name": "mediacatalog-batchupload",
  "upload_source_maps": true,
  "vars": {
    "API_BASE_URL": "https://mediacatalog.netlify.app/api/"
  },
  "observability": {
    "enabled": true
  },
  "queues": {
    "producers": [
      {
        "queue": "mediacatalog-batchupload-queue",
        "binding": "BATCHUPLOADQUEUE"
      }
    ],
    "consumers": [
      {
        "queue": "mediacatalog-batchupload-queue"
      }
    ]
  }
}